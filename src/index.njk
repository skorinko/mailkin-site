---js
{
  pagination: { data: "site.locales", size: 1, alias: "locale", addAllPagesToCollections: true },
  pageKey: "home",
  schema: ["home"],
  placement: "home",
  eleventyComputed: {
    permalink: (d) => `${d.locale.prefix}/`,
    title: (d) => (d.i18n[d.locale.code] || d.i18n.en).home.title,
    description: (d) => (d.i18n[d.locale.code] || d.i18n.en).home.description,
    faqItems: (d) => (d.i18n[d.locale.code] || d.i18n.en).faq.items.slice(0, 4),
    featuredHere: (d) => d.site.featured.filter((f) => f.code !== d.locale.lang),
  },
}
---
<section class="hero">
  <img class="icon" src="/assets/icon.png" alt="{{ t.home.iconAlt }}" width="128" height="128">
  <h1>{{ t.home.h1 }}</h1>
  <p class="lead">{{ t.home.lead }}</p>
  <div class="ctas">
    <a class="cta" href="/download" data-track="download" data-placement="home_hero">{{ t.cta.download }}</a>
    <a class="cta secondary" href="{{ locale.prefix }}/buy/" data-track="pricing" data-placement="home_hero">{{ t.cta.pricing }}</a>
  </div>
  <p class="store-badge"{% if not site.appStoreLive %} hidden{% endif %}><a href="{{ site.appStoreUrl }}" data-track="appstore" data-placement="home_hero"><img src="/assets/mac-app-store-badge.svg" alt="{{ t.cta.appStoreAlt }}" width="156" height="40"></a></p>
  <p class="note">{{ t.cta.note }}</p>
</section>

<figure><img src="/assets/translated.png" alt="{{ t.home.shotTranslatedAlt }}" width="1400" height="914"></figure>

<section class="features">
  {%- for c in t.home.cards %}
  <div class="card"><h3>{{ c[0] }}</h3><p>{{ c[1] | fmt(v) | safe }}</p></div>
  {%- endfor %}
</section>

<h2 class="section">{{ t.home.howTitle }}</h2>
<ol class="steps">
  {%- for s in t.home.howSteps %}
  <li>{{ s }}</li>
  {%- endfor %}
</ol>
<p class="center">{{ t.home.howMore | fmt(v) | safe }}</p>

<h2 class="section">{{ t.home.originalTitle }}</h2>
<figure><img src="/assets/options.png" alt="{{ t.home.shotOptionsAlt }}" width="1400" height="914" loading="lazy"></figure>

<h2 class="section">{{ t.home.languagesTitle }}</h2>
<p class="center">{{ t.home.languagesText }}</p>
<ul class="lang-grid">
  {%- for f in featuredHere %}
  <li><a href="{{ locale.prefix }}/translate/{{ f.slug }}-email/">{{ f.code | langName(locale.code) | cap(locale.intl) }}</a></li>
  {%- endfor %}
  <li><a href="{{ locale.prefix }}/languages/"><strong>{{ t.home.languagesAll }}</strong></a></li>
</ul>

{% include "facts.njk" %}

<h2 class="section">{{ t.home.faqTitle }}</h2>
{% include "faq.njk" %}
<p class="center"><a href="{{ locale.prefix }}/faq/">{{ t.home.faqMore }}</a></p>

{% include "band.njk" %}
